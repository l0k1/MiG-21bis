<?xml version="1.0"?>

<!-- from HAVE DONUT pp 2-29
Afterburner ignition required 2 to 3 seconds from
initiation to full CRT. [...] The afterburner
did not ignite until 100 percent RPM was attained. If the
throttle was not placed in the full afterburner detent for
ignition, a delay of up to 9 seconds was experienced.
-->

<system name="propulsion">
    <channel name="Throttle">

        <!-- throttle distributions, split milthrust, augthrust and clrthrust -->
        <fcs_function name="trash/asdf1234000_90">
            <function>
                <random/>
            </function>
            <output>rando</output>
        </fcs_function>

        <fcs_function name="trash/asdf1234">
            <function>
                <table>
                    <independentVar lookup="row">fcs/throttle-cmd-norm</independentVar>
                    <tableData>
                        0.00    0.00
                        0.75    1.00
                        1.00    1.00
                    </tableData>
                </table>
            </function>
            <output>fcs/throttle-redist-mil</output>
        </fcs_function>

        <fcs_function name="trash/asdeeefsd">
            <function>
                <table>
                    <independentVar lookup="row">fcs/throttle-cmd-norm</independentVar>
                    <tableData>
                        0.00    0.00
                        0.80    0.00
                        1.00    1.00
                    </tableData>
                </table>
            </function>
            <output>fcs/throttle-redist-aug-predelay</output>
        </fcs_function>

        <kinematic name="throttle-redist-aug">
            <input>fcs/throttle-redist-aug-predelay</input>
            <traverse>
                <setting>
                    <position>0.0000</position>
                    <time>0.0000</time>
                </setting>
                <setting>
                    <position>1.0000</position>
                    <time>0.2500</time>
                </setting>
            </traverse>
        </kinematic>


        <switch name="aug-delay-switch">
            <default value="0"/>
            <test logic="AND" value="1">
                propulsion/engine[0]/n2 ge 100
            </test>
        </switch>

        <kinematic name="aug-delay">
            <input>fcs/aug-delay-switch</input>
            <noscale/>
            <traverse>
                <setting>
                    <position>0.0000</position>
                    <time>0.0000</time>
                </setting>
                <setting>
                    <position>1.0000</position>
                    <time>9.0000</time>
                </setting>
            </traverse>
        </kinematic>

        <fcs_function name="trash/asdfp3df32">
            <function>
                <table>
                    <independentVar>fcs/throttle-redist-aug</independentVar>
                    <tableData>
                        0.001  1.000
                        1.000  0.333
                    </tableData>
                </table>
            </function>
            <clipto>
                <min>0.0</min>
                <max>1.0</max>
            </clipto>
            <output>fcs/throttle-aug-compare</output>
        </fcs_function>

        <switch name="aug-active">
            <default value="0"/>
            <test logic="AND" value="1">
                propulsion/engine[0]/n2 ge 100
                fcs/aug-delay ge fcs/throttle-aug-compare
                fcs/blc == 0
            </test>
        </switch>

        <fcs_function name="trash/asdfp32">
            <function>
                <ifthen>
                    <property>systems/air-intake/surging</property>
                    <value>0</value>
                    <sum>
                        <property>fcs/throttle-redist-mil</property>
                        <product>
                            <property>fcs/throttle-redist-aug</property>
                            <property>fcs/aug-active</property>
                            <gt>
                                <property>electric/output/full-throttle-reheat</property>
                                <value>25</value>
                            </gt>
                        </product>
                    </sum>
                </ifthen>
            </function>
            <clipto>
                <min>0.0</min>
                <max>2.0</max>
            </clipto>
            <output>fcs/throttle-pos-norm</output>
        </fcs_function>

    </channel>


    <channel name="nozzle">

    <!--
    flow thoughts
    if fcs/throttle-redist-aug-predelay is less than or equal to 0, use /engines/engine[0]/nozzle-pos-norm
    if fcs/throttle-redist-aug-predelay is greater than 0, nozzle = 1
    this gets us away from the nozzle only being open when the afterburner is ignited
    -->

        <fcs_function name="trash/propulsion/engine[0]/nozzle-pos-norm-corrected">
            <function>
                <ifthen>
                    <gt>
                        <property>fcs/throttle-redist-aug-predelay</property>
                        <value>0</value>
                    </gt>
                    <value>1</value>
                    <property>/engines/engine[0]/nozzle-pos-norm</property>
                </ifthen>
            </function>
            <clipto>
                <min>0.0</min>
                <max>1.0</max>
            </clipto>
            <output>propulsion/engine[0]/nozzle-pos-norm-corrected</output>
        </fcs_function>

        <fcs_function name="trash/propulsion/engine[0]/ideal-nozzle-pos">
            <function>
            <!-- N1 - IdleN1 / MaxN1 - IdleN1 -->
                <ifthen>
                    <property>/engines/engine[0]/augmentation</property>
                    <value>1</value>
                    <difference>
                        <value>1</value>
                        <quotient>
                            <difference>
                                <property>propulsion/engine/n1</property>
                                <value>35</value>
                            </difference>
                            <difference>
                                <property>propulsion/engine/MaxN1</property>
                                <value>35</value>
                            </difference>
                        </quotient>
                    </difference>
                </ifthen>
            </function>
            <clipto>
                <min>0.0</min>
                <max>1.0</max>
            </clipto>
            <output>propulsion/engine[0]/ideal-nozzle-pos</output>
        </fcs_function>

        <!-- if fcs/throttle-cmd-norm = 0, jet nozzle = 1, scale to 0 at 0.75, then at and above 0.8, go back to 1 -->
        <!-- if fcs/blc is gt 0, then when throttle gt 0.8, set nozzle to 0.5 -->
        <fcs_function name="trash/propulsion/engine[0]/nozzle-cmd-norm">
            <function>
                <ifthen>
                    <gt>
                        <property>fcs/blc</property>
                        <value>0</value>
                    </gt>
                    <table>
                        <independentVar lookup="row">fcs/throttle-cmd-norm</independentVar>
                        <tableData>
                            0.0     1.0
                            0.75    0.0
                            0.7999  0.0
                            0.80    0.15
                            1.0     0.15
                        </tableData>
                    </table>
                    <table>
                        <independentVar lookup="row">fcs/throttle-cmd-norm</independentVar>
                        <tableData>
                            0.0     1.0
                            0.75    0.0
                            0.7999  0.0
                            0.80    1.0
                            1.0     1.0
                        </tableData>
                    </table>
                </ifthen>
            </function>
            <output>propulsion/engine[0]/nozzle-cmd-norm</output>
        </fcs_function>

        <fcs_function name="trash/propulsion/engine[0]/nozzle-rate">
            <function>
                <table>
                    <independentVar lookup="row">systems/hydraulic[0]/pressure</independentVar>
                    <tableData>
                        0.0     0.0
                        50.0    0.5
                        150.0   1.0
                    </tableData>
                </table>
            </function>
            <output>propulsion/engine[0]/nozzle-rate</output>
        </fcs_function>

        <actuator name="trash/propulsion/engine[0]/nozzle-pos-norm">
            <input>propulsion/engine[0]/nozzle-cmd-norm</input>
            <rate_limit>propulsion/engine[0]/nozzle-rate</rate_limit>
            <output>propulsion/engine[0]/nozzle-pos-norm</output>
        </actuator>

    </channel>

    <channel name="maxn1n2">

        <!-- increase max n1/n2 based on airspeed and air pressure -->
        <fcs_function name="trash/propulsion/engine[0]/nmod">
            <!-- 
            speed/qnh relationship taken from air_intake.xml
            mostly pulling this from my ass. :thumbs_up:
            -->
            <function>
                <table>
                    <independentVar lookup="row">/environment/pressure-inhg</independentVar>
                    <independentVar lookup="column">velocities/vc-kts</independentVar>
                    <tableData>
                                0.00    675     702     770     837     864     877
                        0.00    0.95    0.95    0.95    0.95    0.95    0.95    0.95
                        3.27    0.95    0.96    0.97    0.98    0.99    1.00    1.01
                        5.52    0.95    0.97    0.98    0.99    1.00    1.01    1.02
                        8.89    0.95    0.98    0.99    1.00    1.01    1.02    1.03
                        20.6    0.95    0.99    1.00    1.01    1.02    1.03    1.04
                        29.9    0.95    1.00    1.01    1.02    1.03    1.04    1.05
                        32.1    0.95    1.01    1.02    1.03    1.04    1.05    1.06
                    </tableData>
                </table>
            </function>
            <output>propulsion/engine[0]/nmod</output>
        </fcs_function>

        <pure_gain name="trash/propulsion/engine[0]/MaxN1">
            <input>propulsion/engine[0]/nmod</input>
            <gain>103.5</gain>
            <output>propulsion/engine[0]/MaxN1</output>
        </pure_gain>

        <pure_gain name="trash/propulsion/engine[0]/MaxN2">
            <input>propulsion/engine[0]/nmod</input>
            <gain>107.5</gain>
            <output>propulsion/engine[0]/MaxN2</output>
        </pure_gain>

    </channel>

    <property value="365">propulsion/engine/egt/idle-ideal</property>
    <property value="680">propulsion/engine/egt/mil-ideal</property>
    <property value="0.2">propulsion/engine/egt/idle-fuel-flow-ideal</property>
    <property value="2.25">propulsion/engine/egt/mil-fuel-flow-ideal</property>
    <property value="0">propulsion/engine/egt/n1-norm</property>
    <property value="0">propulsion/engine/egt/n1-target</property>
    <property value="0">propulsion/engine/egt/fuel-norm</property>
    <property value="0">propulsion/engine/egt/fuel-target</property>
    <property value="0">propulsion/engine/egt/test-pressure</property>
    <property value="0">propulsion/engine/egt/target-c</property>
    <property value="1">propulsion/engine/fuel-flow-rate-change</property>
    <property value="1">propulsion/engine/fuel-flow-rate-previous</property>
    <property value="0.14">propulsion/engine/egt/transient-spike-lag-c1</property>
    <property value="3">propulsion/engine/egt/transient-spike-prelag</property>
    <property value="0.4">propulsion/engine/egt/final-temp-c1</property>
    <property value="0.000007">propulsion/engine/egt/density-constant</property>

    <channel name="egt">

        <fcs_function>
        <!-- get fuel flow at milthrust -->
        <!-- hacky af -->
        <!-- basically a workaround to try and ignore some augmented fuel consumption -->
            <function>
                <interpolate1d>
                    <property>position/h-sl-ft</property>
                    <value>0</value><value>750</value>
                    <value>60000</value><value>400</value>
                </interpolate1d>
            </function>
            <clipto>
                <min>400</min>
                <max>730</max>
            </clipto>
            <output>propulsion/engine/egt/mil-ideal</output>
        </fcs_function>


        <fcs_function>
            <!-- normalized fuel flow -->
            <!-- ((fuel_flow - fuel_flow_idle) / (fuel_flow_mil - fuel_flow_idle)) ^ scale_factor -->
            <!-- scale factor arbitrarly set to 1.5 -->
            <function>
                <ifthen>
                    <gt>
                        <property>propulsion/engine/fuel-flow-rate-pps</property>
                        <property>propulsion/engine/egt/idle-fuel-flow-ideal</property>
                    </gt>
                    <pow>
                        <quotient>
                            <difference>
                                <ifthen>
                                    <!-- prevent spike due to afterburner using too much fuel -->
                                    <gt>
                                        <property>propulsion/engine/fuel-flow-rate-pps</property>
                                        <property>propulsion/engine/egt/mil-fuel-flow-ideal</property>
                                    </gt>
                                    <property>propulsion/engine/egt/mil-fuel-flow-ideal</property>
                                    <property>propulsion/engine/fuel-flow-rate-pps</property>
                                </ifthen>
                                <property>propulsion/engine/egt/idle-fuel-flow-ideal</property>
                            </difference>
                            <difference>
                                <property>propulsion/engine/egt/mil-fuel-flow-ideal</property>
                                <property>propulsion/engine/egt/idle-fuel-flow-ideal</property>
                            </difference>
                        </quotient>
                        <value>1.5</value>
                    </pow>
                    <property>propulsion/engine/egt/idle-fuel-flow-ideal</property>
                </ifthen>
            </function>
            <output>propulsion/engine/egt/fuel-norm</output>
        </fcs_function>

        <fcs_function>
            <!-- target EGT based on fuel flow-->
            <!-- ilde + (mil - idle) * fuel-norm -->
            <function>
                <ifthen>
                    <lt>
                        <property>propulsion/engine/n1</property>
                        <value>35</value>
                    </lt>
                    <interpolate1d>
                        <property>propulsion/engine/n1</property>
                        <value>0</value><value>0</value>
                        <value>35</value><property>propulsion/engine/egt/idle-ideal</property>
                    </interpolate1d>
                    <sum>
                        <property>propulsion/engine/egt/idle-ideal</property>
                        <product>
                            <difference>
                                <property>propulsion/engine/egt/mil-ideal</property>
                                <property>propulsion/engine/egt/idle-ideal</property>
                            </difference>
                            <property>propulsion/engine/egt/fuel-norm</property>
                        </product>
                    </sum>
                </ifthen>
            </function>
            <output>propulsion/engine/egt/fuel-target</output>
        </fcs_function>

        <lag_filter>
            <!-- transient spike lag filter -->
            <input>propulsion/engine/egt/fuel-target</input>
            <c1>0.25</c1>
            <output>propulsion/engine/egt/fuel-mod</output>
        </lag_filter>

        <fcs_function>
            <!-- modify egt target based on altitude/air pressure. -->
            <!-- approximating 2C per 1000 ft. i dont have hard data. -->
            <!-- 2c per 0.0000448 slug/ft^3 -->
            <!-- iso standard sea level is 0.002377 -->
            <!-- (0.002377 - current) / 0.0000448 -->
            <function>
                <quotient>
                    <difference>
                        <value>0.002377</value>
                        <property>atmosphere/rho-slugs_ft3</property>
                    </difference>
                    <property>propulsion/engine/egt/density-constant</property>
                </quotient>
            </function>
            <output>propulsion/engine/egt/density-mod</output>
        </fcs_function>

        <fcs_function>
            <!-- afterburner modification -->
            <!-- 40C with 1st stage, 60C with second -->
            <function>
                <sum>
                    <product>
                        <property>fcs/aug-active</property>
                        <property>fcs/throttle-redist-aug</property>
                        <value>40</value>
                    </product>
                    <product>
                        <property>propulsion/clr</property>
                        <value>40</value>
                    </product>
                </sum>
            </function>
            <output>propulsion/engine/egt/afterburner-mod</output>
        </fcs_function>

        <fcs_function>
            <!-- mach modification -->
            <!-- ambient temp * (1 + (0.2 * (mach^2)) -->
            <function>
                <difference>
                    <product>
                        <sum>
                            <value>273.15</value>
                            <property>/environment/temperature-degc</property>
                        </sum>
                        <sum>
                            <value>1</value>
                            <product>
                                <value>0.2</value>
                                <pow>
                                    <property>velocities/mach</property>
                                    <value>2</value>
                                </pow>
                            </product>
                        </sum>
                    </product>
                    <value>273.15</value>
                </difference>
            </function>
            <output>propulsion/engine/egt/mach-mod</output>
        </fcs_function>
<!--
        <pure_gain>
            <input>simulation/channel-dt</input>
            <gain>1.0</gain>
            <output>propulsion/engine/dt</output>
        </pure_gain>
-->
        <fcs_function>
            <!-- fuel flow rate change -->
            <function>
                <quotient>
                    <difference>
                        <property>propulsion/engine/fuel-flow-rate-pps</property>
                        <property>propulsion/engine/fuel-flow-rate-previous</property>
                    </difference>
                    <sum>
                        <property>simulation/channel-dt</property>
                        <value>0.00000000001</value>
                    </sum>
                </quotient>
            </function>
            <output>propulsion/engine/fuel-flow-rate-change</output>
        </fcs_function>

        <pure_gain>
            <input>propulsion/engine/fuel-flow-rate-pps</input>
            <gain>1.0</gain>
            <output>propulsion/engine/fuel-flow-rate-previous</output>
        </pure_gain>

        <fcs_function>
            <!-- transient spike -->
            <!-- 169 is a randomly chosen number ';,,;' -->
            <function>
                <product>
                    <property>propulsion/engine/fuel-flow-rate-change</property>
                    <value>69</value>
                </product>
            </function>
            <output>propulsion/engine/egt/transient-spike-prelag</output>
        </fcs_function>

        <lag_filter>
            <!-- transient spike lag filter -->
            <input>propulsion/engine/egt/transient-spike-prelag</input>
            <c1>propulsion/engine/egt/transient-spike-lag-c1</c1>
            <output>propulsion/engine/egt/transient-spike</output>
        </lag_filter>

        <fcs_function>
            <!-- final target temp -->
            <function>
                <sum>
                    <property>propulsion/engine/egt/fuel-mod</property>
                    <property>propulsion/engine/egt/density-mod</property>
                    <property>propulsion/engine/egt/afterburner-mod</property>
                    <property>propulsion/engine/egt/mach-mod</property>
                    <property>propulsion/engine/egt/transient-spike</property>
                </sum>
            </function>
            <clipto>
                <min>0</min>
                <max>1300</max>
            </clipto>
            <output>propulsion/engine/egt/target-c</output>
        </fcs_function>

        <lag_filter>
            <!-- transient spike lag filter -->
            <input>propulsion/engine/egt/target-c</input>
            <c1>propulsion/engine/egt/final-temp-c1</c1>
            <output>propulsion/engine/egt/egt-degc</output>
        </lag_filter>

    </channel>
</system>
