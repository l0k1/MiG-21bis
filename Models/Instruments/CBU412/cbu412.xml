<?xml version="1.0"?>
<PropertyList>

    <path>cbu412.ac</path>

	<!--displays-->
	
	<animation>
		<type>material</type> 
		<object-name>Display_Left</object-name>
		<object-name>Display_Right</object-name>
		<emission>
			<red>0.8</red>
			<green>0</green>
			<blue>0</blue>
		</emission>
		<factor-prop>/instrumentation/transponder/cbu412/powerknob</factor-prop>
	</animation>
	
	
	<!-- switches and knobs -->
	

	<animation>
		<type>pick</type>
		<object-name>dimSwitch</object-name>
		<action>
			<button>0</button>
			<repeatable>false</repeatable>
			<binding>
				<command>nasal</command>
				<script>cbu412.switch_dim(0);</script>
			</binding>
			<mod-up>
				<binding>
					<command>nasal</command>
					<script>cbu412.switch_dim(2);</script>
				</binding>
			</mod-up>
		</action>
		<action>
			<button>1</button>
			<repeatable>false</repeatable>
				<binding>
					<command>nasal</command>
					<script>cbu412.switch_dim(1);</script>
				</binding>
			<mod-up>
				<binding>
					<command>nasal</command>
					<script>cbu412.switch_dim(2);</script>
				</binding>
			</mod-up>
		</action>
	</animation>

	<animation>
		<object-name>dimSwitch</object-name>
		<type>rotate</type>
		<property>/instrumentation/transponder/cbu412/dim</property>
		<factor>-20</factor>
		<offset-deg>0</offset-deg>
		<center>
			<x-m>0.001725</x-m>
			<y-m>-0.032982</y-m>
			<z-m>0.052156</z-m>
		</center>
		<axis>
			<x>0</x>
			<y>1</y>
			<z>0</z>
		</axis>
	</animation>

